# Data backend: "local" (browser storage, no account, great for debugging) or "supabase".
NEXT_PUBLIC_DATA_BACKEND=local

# Supabase (only needed when NEXT_PUBLIC_DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# JSON merged over src/config/app.config.ts at build time, e.g. {"restTimer":{"defaultSeconds":90}}
NEXT_PUBLIC_CONFIG_OVERRIDES=
