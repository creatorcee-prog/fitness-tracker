# Data backend: "local" (browser storage, no account, great for debugging) or "supabase".
NEXT_PUBLIC_DATA_BACKEND=local

# Supabase (only needed when NEXT_PUBLIC_DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# JSON merged over src/config/app.config.ts at build time, e.g. {"restTimer":{"defaultSeconds":90}}
NEXT_PUBLIC_CONFIG_OVERRIDES=

# Discord bot (server-only; set in Vercel, never commit real values)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: link the bot sends people to (defaults to the request's origin)
NEXT_PUBLIC_APP_URL=
# Shared secret Supabase Cron sends to /api/cron/reminders (any long random string)
CRON_SECRET=
