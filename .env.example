# Data backend: "local" (browser storage, no account, great for debugging) or "supabase".
NEXT_PUBLIC_DATA_BACKEND=local

# Supabase (only needed when NEXT_PUBLIC_DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# JSON merged over src/config/app.config.ts at build time, e.g. {"restTimer":{"defaultSeconds":90}}
NEXT_PUBLIC_CONFIG_OVERRIDES=

# Discord bot (server-only; set in Vercel, never commit real values)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: link the bot sends people to (defaults to the request's origin)
NEXT_PUBLIC_APP_URL=
# Shared secret Supabase Cron sends to /api/cron/reminders (any long random string)
CRON_SECRET=

# AI /ask (server-only; Groq's OpenAI-compatible API). Leave GROQ_API_KEY empty to keep /ask off.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: used when the first model returns 429 (rate limited)
GROQ_FALLBACK_MODEL=
AI_ENABLED=true
AI_DAILY_USER_LIMIT=10
AI_DAILY_GLOBAL_LIMIT=70
# Optional: output cap (includes reasoning tokens on gpt-oss) and context budget
AI_MAX_OUTPUT_TOKENS=500
AI_CONTEXT_TOKENS=2000
# Optional: another OpenAI-compatible endpoint (defaults to https://api.groq.com/openai/v1)
AI_BASE_URL=
# Optional sampling settings for /ask
AI_TEMPERATURE=0.5
AI_TOP_P=0.9
AI_FREQUENCY_PENALTY=0.25
# In-app chat: earlier exchanges sent along for follow-up questions (0 = none)
AI_CHAT_HISTORY_TURNS=2
